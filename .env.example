# Django core
# DEBUG: set False for staging/production
DEBUG=True
# SECRET_KEY or DJANGO_SECRET_KEY (use a long random string in production)
SECRET_KEY=change-me-in-production-use-a-long-random-string
# Comma-separated hostnames (add your domain for staging/production)
ALLOWED_HOSTS=localhost,127.0.0.1,web
# Comma-separated origins for CSRF (e.g. https://app.example.com)
CSRF_TRUSTED_ORIGINS=

# Database
# Option A: single connection string (recommended for Docker)
DATABASE_URL=postgres://aiagent:aiagent@postgres:5432/ai_agent_os
# Option B: individual vars (used when DATABASE_URL is empty)
# DB_NAME=ai_agent_os
# DB_USER=aiagent
# DB_PASSWORD=aiagent
# DB_HOST=localhost
# DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# AI Provider: openai | groq | gemini | mock
# Use mock for demos and CI (no external API keys required)
AI_PROVIDER=mock
AI_MODEL_NAME=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.3
AI_FALLBACK_PROVIDER=mock
AI_DAILY_TOKEN_BUDGET=
AI_MONTHLY_TOKEN_BUDGET=
# Force mock for scenario audit (default: mock)
AUDIT_AI_PROVIDER=mock

# Encryption key for channel credentials (generate with Fernet)
CREDENTIALS_ENCRYPTION_KEY=

# Meta / WhatsApp / Instagram integrations
# INTEGRATIONS_MOCK_MODE=True skips live Meta API calls and signature enforcement
META_VERIFY_TOKEN=ai-agent-os-verify
META_APP_SECRET=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_PAGE_ID=
INTEGRATIONS_MOCK_MODE=True
